<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.sistemagestion.controller.ReversionController"
            prefWidth="1200" prefHeight="760"
            style="-fx-background-color: #f1f5f9;">

    <top>
        <VBox spacing="8"
              style="-fx-background-color: #102448;">
            <padding>
                <Insets top="20" right="24" bottom="20" left="24"/>
            </padding>
            <Label text="GESTIÓN DE REVERSIONES"
                   style="-fx-text-fill: white; -fx-font-size: 25px; -fx-font-weight: bold;"/>
            <Label fx:id="lblUsuario" text="Usuario:"
                   style="-fx-text-fill: #bfdbfe; -fx-font-size: 13px;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="16">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <VBox spacing="10"
                  style="-fx-background-color: white; -fx-background-radius: 10;">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>

                <Label text="Solicitar reversión de producto"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #102448;"/>

                <Label text="Selecciona el detalle de una venta completada:"/>
                <ComboBox fx:id="cmbDetalle"
                          maxWidth="Infinity"
                          promptText="Seleccionar venta y producto"/>

                <GridPane hgap="12" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="75"/>
                    </columnConstraints>

                    <Label text="Cantidad:" GridPane.rowIndex="0"
                           GridPane.columnIndex="0"/>
                    <TextField fx:id="txtCantidad"
                               promptText="Ej. 1"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>

                    <Label text="Motivo:" GridPane.rowIndex="1"
                           GridPane.columnIndex="0"/>
                    <TextArea fx:id="txtMotivo"
                              promptText="Describe por qué se solicita la reversión"
                              prefRowCount="2" wrapText="true"
                              GridPane.rowIndex="1"
                              GridPane.columnIndex="1"/>
                </GridPane>

                <Button fx:id="btnSolicitar"
                        text="Registrar solicitud"
                        onAction="#solicitarReversion"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"
                        prefHeight="38"/>
            </VBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Solicitudes pendientes"
                       style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #102448;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Actualizar" onAction="#actualizarListas"/>
            </HBox>

            <TableView fx:id="tablaSolicitudes" VBox.vgrow="ALWAYS"
                       prefHeight="320">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="55"/>
                    <TableColumn fx:id="colVenta" text="Venta" prefWidth="85"/>
                    <TableColumn fx:id="colProducto" text="Producto" prefWidth="140"/>
                    <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="85"/>
                    <TableColumn fx:id="colMonto" text="Monto Q" prefWidth="90"/>
                    <TableColumn fx:id="colMotivo" text="Motivo" prefWidth="180"/>
                    <TableColumn fx:id="colSolicitante" text="Solicitante" prefWidth="110"/>
                    <TableColumn fx:id="colFecha" text="Fecha" prefWidth="135"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button fx:id="btnAutorizar"
                        text="Autorizar y restituir inventario"
                        onAction="#autorizarReversion"
                        style="-fx-background-color: #059669; -fx-text-fill: white;"/>
                <Button fx:id="btnRechazar"
                        text="Rechazar solicitud"
                        onAction="#rechazarReversion"
                        style="-fx-background-color: #dc2626; -fx-text-fill: white;"/>

                <Button text="Cerrar"
                        onAction="#regresarMenuAdministrador" />

            </HBox>
        </VBox>
    </center>
</BorderPane>
