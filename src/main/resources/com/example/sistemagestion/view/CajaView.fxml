<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.sistemagestion.controller.CajaController"
      spacing="12"
      prefWidth="620"
      prefHeight="650"
      style="-fx-background-color: #f4f6f9;">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <Label text="GESTIÓN DE CAJA"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Label text="Seleccione una caja para consultar, abrir o cerrar un turno."/>

    <Separator/>

    <Label text="Caja registradora"/>

    <ComboBox fx:id="cmbCaja"
              prefWidth="550"
              maxWidth="Infinity"
              promptText="Seleccione una caja"/>

    <Label text="Fondo inicial (Q)"/>

    <TextField fx:id="txtFondoInicial"
               promptText="Ejemplo: 500.00"/>

    <Label text="Observaciones"/>

    <TextArea fx:id="txtObservaciones"
              prefRowCount="2"
              wrapText="true"
              promptText="Observaciones opcionales"/>

    <HBox spacing="10">
        <Button text="Abrir turno"
                onAction="#abrirTurno"
                style="-fx-background-color: #1976d2; -fx-text-fill: white; -fx-font-weight: bold;"/>

        <Button text="Consultar turno"
                onAction="#consultarTurno"/>

        <Button text="Actualizar cajas"
                onAction="#cargarCajas"/>
    </HBox>

    <Separator/>

    <Label text="Cierre de caja"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Label text="Efectivo contado físicamente (Q)"/>

    <TextField fx:id="txtEfectivoDeclarado"
               promptText="Ejemplo: 1250.00"/>

    <Button text="Cerrar turno"
            onAction="#cerrarTurno"
            style="-fx-background-color: #c62828; -fx-text-fill: white; -fx-font-weight: bold;"/>

    <Separator/>

    <Label text="Estado de la caja"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <Label fx:id="lblEstado"
           text="Cargando cajas..."
           wrapText="true"
           style="-fx-font-size: 13px;"/>

    <HBox alignment="CENTER_LEFT">
        <Button text="← Volver al menú"
                onAction="#volverAlMenu"
                style="-fx-background-color: #455a64; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

</VBox>
