<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.sistemagestion.controller.ProductoController"
            prefWidth="1100" prefHeight="720"
            style="-fx-background-color: #f4f6f9;">

    <top>
        <VBox spacing="6" style="-fx-background-color: #1f3a5f;">
            <padding>
                <Insets top="18" right="24" bottom="18" left="24"/>
            </padding>
            <Label text="GESTIÓN DE PRODUCTOS"
                   style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Label text="Registro, consulta y control de productos del supermercado"
                   style="-fx-text-fill: #dbeafe; -fx-font-size: 13px;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="14">
            <padding>
                <Insets top="18" right="24" bottom="18" left="24"/>
            </padding>

            <Label text="Datos del producto"
                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>

            <GridPane hgap="12" vgap="10">
                <padding>
                    <Insets bottom="8"/>
                </padding>

                <Label text="SKU *" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtSku" promptText="Ej. BEB-001"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Código de barras" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <TextField fx:id="txtCodigoBarras" promptText="Código opcional"
                           GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <Label text="Nombre *" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtNombre" promptText="Nombre del producto"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Descripción" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <TextField fx:id="txtDescripcion" promptText="Descripción opcional"
                           GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                <Label text="Precio de venta *" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="txtPrecio" promptText="0.00"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Costo *" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                <TextField fx:id="txtCosto" promptText="0.00"
                           GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                <Label text="Existencia *" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="txtExistencia" promptText="0"
                           GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Stock mínimo *" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                <TextField fx:id="txtStockMinimo" promptText="0"
                           GridPane.columnIndex="3" GridPane.rowIndex="3"/>

                <Label text="Unidad de medida *" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <ComboBox fx:id="cmbUnidad" maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label text="Categoría" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                <ComboBox fx:id="cmbCategoria" maxWidth="Infinity"
                          promptText="Seleccionar categoría"
                          GridPane.columnIndex="3" GridPane.rowIndex="4"/>

                <columnConstraints>
                    <javafx.scene.layout.ColumnConstraints minWidth="115"/>
                    <javafx.scene.layout.ColumnConstraints hgrow="ALWAYS" minWidth="150"/>
                    <javafx.scene.layout.ColumnConstraints minWidth="125"/>
                    <javafx.scene.layout.ColumnConstraints hgrow="ALWAYS" minWidth="150"/>
                </columnConstraints>
            </GridPane>

            <HBox spacing="10">
                <Button text="Registrar producto" onAction="#registrarProducto"
                        style="-fx-background-color: #198754; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Limpiar" onAction="#limpiarFormulario"/>
                <Button text="Desactivar seleccionado" onAction="#desactivarProducto"
                        style="-fx-background-color: #b42318; -fx-text-fill: white;"/>
            </HBox>

            <Label text="Productos registrados"
                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>

            <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="55"/>
                    <TableColumn fx:id="colSku" text="SKU" prefWidth="105"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="190"/>
                    <TableColumn fx:id="colPrecio" text="Precio" prefWidth="100"/>
                    <TableColumn fx:id="colExistencia" text="Existencia" prefWidth="100"/>
                    <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="150"/>
                    <TableColumn fx:id="colActivo" text="Activo" prefWidth="75"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER_LEFT">
                <Button text="Regresar al menú principal" onAction="#regresarMenu"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
