<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.sistemagestion.controller.UsuariosController"
            style="-fx-background-color: #f1f5f9;">

    <top>
        <VBox spacing="8"
              style="-fx-background-color: #14284b;">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="ADMINISTRACIÓN DE USUARIOS"
                   style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>

            <Label text="Registro, roles y control de acceso"
                   style="-fx-text-fill: #dbeafe; -fx-font-size: 13px;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="14">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscar"
                           promptText="Buscar por usuario, nombre o rol..."
                           HBox.hgrow="ALWAYS"/>

                <Button text="Actualizar"
                        onAction="#actualizarLista"/>
            </HBox>

            <TableView fx:id="tablaUsuarios"
                       VBox.vgrow="ALWAYS">

                <columns>
                    <TableColumn fx:id="colId"
                                 text="ID"
                                 prefWidth="60"/>

                    <TableColumn fx:id="colUsername"
                                 text="Usuario"
                                 prefWidth="150"/>

                    <TableColumn fx:id="colNombre"
                                 text="Nombre completo"
                                 prefWidth="260"/>

                    <TableColumn fx:id="colRol"
                                 text="Rol"
                                 prefWidth="150"/>

                    <TableColumn fx:id="colEstado"
                                 text="Estado"
                                 prefWidth="100"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Nuevo usuario"
                        onAction="#crearUsuario"
                        style="-fx-background-color: #166534; -fx-text-fill: white;"/>

                <Button text="Editar nombre"
                        onAction="#editarUsuario"/>

                <Button text="Cambiar contraseña"
                        onAction="#cambiarPassword"/>

                <Button text="Cambiar rol"
                        onAction="#cambiarRol"/>

                <Button text="Activar / desactivar"
                        onAction="#cambiarEstado"
                        style="-fx-background-color: #b45309; -fx-text-fill: white;"/>
                <Button text="Regresar al menú"
                        onAction="#regresarMenu"
                        style="-fx-background-color: #14284b; -fx-text-fill: white;"/>
            </HBox>


        </VBox>
    </center>

</BorderPane>
