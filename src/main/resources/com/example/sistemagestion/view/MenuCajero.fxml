<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.sistemagestion.controller.MenuCajeroController"
      alignment="CENTER"
      spacing="18"
      prefWidth="800"
      prefHeight="550"
      style="-fx-background-color: #f1f5f9;">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="SUPERMERCADO"
           style="-fx-font-size: 16px; -fx-text-fill: #2563eb;"/>

    <Label text="Panel del cajero"
           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #102448;"/>

    <Label fx:id="lblUsuario"
           text="Usuario: Cajero"
           style="-fx-font-size: 15px; -fx-text-fill: #475569;"/>

    <Button text="Gestión de caja"
            onAction="#abrirCaja"
            prefWidth="260"
            prefHeight="45"/>

    <Button text="Punto de venta"
            onAction="#abrirVentas"
            prefWidth="260"
            prefHeight="45"/>

    <Button text="Cerrar sesión"
            onAction="#cerrarSesion"
            prefWidth="260"
            prefHeight="40"/>

</VBox>
